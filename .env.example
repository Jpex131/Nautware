# Server Configuration
PORT=3000
SESSION_SECRET=your-session-secret-here

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nautware_db

# Test-only Bitcoin Lightning checkout. Use an LNbits wallet backed by regtest,
# testnet, or signet; the returned BOLT11 invoice must match this network.
LIGHTNING_NETWORK=regtest
LNBITS_URL=http://localhost:5000
LNBITS_INVOICE_KEY=
LNBITS_INVOICE_EXPIRY_SECONDS=900
