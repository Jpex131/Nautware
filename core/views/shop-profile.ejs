<%- include('partials/header') %>

<div class="dashboard-container" style="padding: 24px 24px 48px; max-width: 1200px; margin: 0 auto; color: white;">
    <div style="position: relative; overflow: hidden; border-radius: 20px; background: #11131a;">
        <div style="min-height: 260px; background-size: cover; background-position: center; background-repeat: no-repeat; background-image: <%= shop.shop_banner_url ? `url('${shop.shop_banner_url}')` : 'none' %>; background-color: <%= shop.shop_banner_url ? 'transparent' : '#11131a' %>;">
        </div>
        <div style="position: absolute; left: 50%; bottom: -48px; transform: translateX(-50%); width: 96px; height: 96px; border-radius: 50%; border: 4px solid var(--bg-surface); background: #171824; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <% if (shop.shop_image_url) { %>
                <img src="<%= shop.shop_image_url %>" alt="<%= shop.shop_name %> logo" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--accent-500); font-size: 1.5rem;">S</div>
            <% } %>
        </div>
    </div>

    <div style="margin-top: 72px; text-align: center;">
        <h1 style="margin: 0; font-size: 2.5rem; color: var(--text-primary);"> <%= shop.shop_name %> </h1>
        <p style="margin: 12px auto 0; max-width: 760px; color: var(--text-muted); font-size: 1rem; line-height: 1.8;"> <%= shop.shop_description || 'No shop description provided yet.' %> </p>
        <% if (isOwner) { %>
            <button onclick="document.getElementById('shop-edit-modal').style.display='flex'" style="margin-top: 18px; padding: 12px 20px; background: var(--accent-500); border: none; border-radius: 8px; color: white; font-weight: 600; cursor: pointer;">Edit Profile</button>
        <% } %>
    </div>

    <div style="display: grid; gap: 24px; margin-top: 40px;">
        <section class="card-erp" style="padding: 24px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
                <div>
                    <h2 style="margin: 0; color: var(--text-primary); font-size: 1.8rem;">Products</h2>
                    <p style="margin: 6px 0 0; color: var(--text-muted);">Browse active listings from this shop.</p>
                </div>
                <div style="color: var(--text-secondary); font-size: 0.95rem;">Total: <strong><%= products ? products.length : 0 %></strong></div>
            </div>

            <% if (products && products.length > 0) { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin-top: 24px;">
                    <% products.forEach(product => { %>
                        <% 
                            let imgUrl = '/assets/images/placeholder.png';
                            if (product.images) {
                                try {
                                    let imgs = typeof product.images === 'string' ? JSON.parse(product.images) : product.images;
                                    if (imgs && imgs.length > 0) imgUrl = imgs[0];
                                } catch(e) {}
                            }
                        %>
                        <div class="card-erp" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; height: 320px; background: rgba(30,30,45,0.85); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; cursor: default;">
                            <div style="height: 160px; width: 100%; background: #12131d; overflow: hidden;">
                                <img src="<%= imgUrl %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                            <div style="padding: 18px; display: flex; flex-direction: column; gap: 10px; flex: 1;">
                                <div style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary);"> <%= product.name %> </div>
                                <div style="color: var(--accent-500); font-size: 1.15rem; font-weight: 700;">$<%= product.price %></div>
                                <div style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;"> <%= product.description %> </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p style="color: var(--text-muted); margin-top: 24px;">No active products found for this shop.</p>
            <% } %>
        </section>

        <section class="card-erp" style="padding: 24px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
                <div>
                    <h2 style="margin: 0; color: var(--text-primary); font-size: 1.8rem;">Posts</h2>
                    <p style="margin: 6px 0 0; color: var(--text-muted);">Updates, announcements, and news from this shop.</p>
                </div>
                <div style="color: var(--text-secondary); font-size: 0.95rem;">Total: <strong><%= posts ? posts.length : 0 %></strong></div>
            </div>

            <% if (isOwner) { %>
                <form action="/inventory/shop/<%= shop.id %>/posts/create" method="POST" style="margin-top: 24px; display: grid; gap: 12px;">
                    <textarea name="content" rows="3" placeholder="Share an update with your buyers..." required style="width: 100%; padding: 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: white; outline: none;"></textarea>
                    <input type="url" name="image_url" placeholder="Optional image URL" style="width: 100%; padding: 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: white; outline: none;">
                    <button type="submit" style="align-self: flex-start; padding: 12px 18px; background: var(--accent-500); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">Publish Post</button>
                </form>
            <% } %>

            <% if (posts && posts.length > 0) { %>
                <div style="display: grid; gap: 18px; margin-top: 24px;">
                    <% posts.forEach(post => { %>
                        <div class="card-erp" style="padding: 20px; background: rgba(30,30,45,0.85); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px;">
                            <% if (post.image_url) { %>
                                <div style="width: 100%; min-height: 180px; overflow: hidden; border-radius: 14px; margin-bottom: 16px; background: #12131d;">
                                    <img src="<%= post.image_url %>" alt="Shop post image" style="width: 100%; height: 100%; object-fit: cover; display: block;">
                                </div>
                            <% } %>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin-bottom: 12px;">
                                <div style="color: var(--text-muted); font-size: 0.92rem;">Posted <%= new Date(post.created_at).toLocaleString() %></div>
                                <% if (isOwner) { %>
                                    <form action="/inventory/shop/<%= shop.id %>/posts/<%= post.id %>/delete" method="POST" style="margin: 0;">
                                        <button type="submit" style="padding: 8px 12px; background: rgba(255,50,50,0.12); color: #ff7777; border: 1px solid rgba(255,50,50,0.2); border-radius: 8px; cursor: pointer; font-size: 0.9rem;">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                            <p style="margin: 0; color: var(--text-secondary); line-height: 1.8; white-space: pre-wrap;"><%= post.content %></p>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p style="color: var(--text-muted); margin-top: 24px;">No posts have been published yet.</p>
            <% } %>
        </section>
    </div>
</div>

<% if (isOwner) { %>
<div id="shop-edit-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center; padding: 24px;">
    <div class="card-erp" style="width: 100%; max-width: 520px; position: relative; padding: 28px; background: rgba(15,16,24,0.98); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px;">
        <button onclick="document.getElementById('shop-edit-modal').style.display='none';" style="position: absolute; right: 18px; top: 18px; background: none; border: none; color: white; font-size: 1.4rem; cursor: pointer;">&times;</button>
        <h2 style="margin: 0 0 14px; color: var(--text-primary);">Edit Shop Profile</h2>
        <form action="/inventory/shop/<%= shop.id %>/update-profile" method="POST" style="display: grid; gap: 16px;">
            <div>
                <label style="display: block; margin-bottom: 8px; color: var(--text-secondary); font-size: 0.95rem;">Shop Description</label>
                <textarea name="shopDescription" rows="4" style="width: 100%; padding: 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: white; outline: none;"><%= shop.shop_description %></textarea>
            </div>
            <div>
                <label style="display: block; margin-bottom: 8px; color: var(--text-secondary); font-size: 0.95rem;">Shop Image URL</label>
                <input type="url" name="shopImageUrl" value="<%= shop.shop_image_url %>" style="width: 100%; padding: 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: white; outline: none;">
            </div>
            <div>
                <label style="display: block; margin-bottom: 8px; color: var(--text-secondary); font-size: 0.95rem;">Shop Banner URL</label>
                <input type="url" name="shopBannerUrl" value="<%= shop.shop_banner_url %>" style="width: 100%; padding: 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: white; outline: none;">
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 8px;">
                <button type="button" onclick="document.getElementById('shop-edit-modal').style.display='none';" style="padding: 12px 18px; background: rgba(255,255,255,0.08); color: var(--text-secondary); border: none; border-radius: 10px; cursor: pointer;">Cancel</button>
                <button type="submit" style="padding: 12px 18px; background: var(--accent-500); color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer;">Save Changes</button>
            </div>
        </form>
    </div>
</div>
<% } %>

<%- include('partials/footer') %>
