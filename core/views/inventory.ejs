<%- include('partials/header') %>

<!-- NEW NAVBAR BASED ON SKETCH -->
<nav class="erp-nav" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 24px; background: rgba(20,20,30,0.95); border-bottom: 1px solid rgba(255,255,255,0.1);">
    <div style="display: flex; gap: 24px; align-items: center;">
        <a href="/dashboard" title="Home" style="color: var(--text-primary); font-size: 1.4rem; text-decoration: none;">🏠</a>
        <a href="/inventory" title="Market" style="color: var(--accent-500); font-size: 1.4rem; text-decoration: none; border-bottom: 2px solid var(--accent-500);">🛒</a>
        <a href="/services" title="Services" style="color: var(--text-primary); font-size: 1.4rem; text-decoration: none;">📅</a>
        <a href="/finance" title="Finance" style="color: var(--text-primary); font-size: 1.4rem; text-decoration: none;">💲</a>
    </div>
    
    <div style="flex: 1; max-width: 500px; margin: 0 24px;">
        <div style="position: relative;">
            <input type="text" placeholder="Search products or stores..." style="width: 100%; padding: 10px 16px 10px 40px; border-radius: 20px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: white; outline: none; font-size: 0.95rem;">
            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-size: 1rem;">🔍</span>
        </div>
    </div>
    
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="text-align: right;">
            <div style="color: var(--text-primary); font-size: 0.9rem; font-weight: 600;"><%= username %></div>
            <a href="/auth/logout" style="color: #ff5555; text-decoration: none; font-size: 0.75rem; text-transform: uppercase;">Disconnect</a>
        </div>
        <div title="Profile" style="width: 36px; height: 36px; background: var(--accent-500); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">👤</div>
    </div>
</nav>

<div class="dashboard-container" style="padding-top: 24px; max-width: 1400px;">

    <% if (shop) { %>
        <!-- SELLER CONTROLS: Switch between My Inventory and Marketplace -->
        <div style="display: flex; gap: 16px; margin-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
            <button onclick="document.getElementById('my-inventory').style.display='block'; document.getElementById('marketplace').style.display='none';" style="background: none; border: none; color: var(--text-secondary); font-size: 1.1rem; font-weight: 600; cursor: pointer;">My Inventory (Seller)</button>
            <button onclick="document.getElementById('my-inventory').style.display='none'; document.getElementById('marketplace').style.display='grid';" style="background: none; border: none; color: var(--accent-500); font-size: 1.1rem; font-weight: 600; cursor: pointer; border-bottom: 2px solid var(--accent-500);">Marketplace (Buyer)</button>
        </div>
        
        <!-- SELLER DASHBOARD (Hidden by default to show marketplace first as per request, wait... seller might want to see marketplace, but let's default to seller view if they are a seller, actually the prompt said "if im a store owner... i would like to see first the state of my business") -->
        <script>
            // We will run this on load to set active states properly.
            document.addEventListener('DOMContentLoaded', () => {
                document.getElementById('my-inventory').style.display = 'block';
                document.getElementById('marketplace').style.display = 'none';
                document.querySelectorAll('button[onclick^="document.getElementById"]').forEach((btn, idx) => {
                    if(idx === 0) { btn.style.color = 'var(--accent-500)'; btn.style.borderBottom = '2px solid var(--accent-500)'; }
                    else { btn.style.color = 'var(--text-secondary)'; btn.style.borderBottom = 'none'; }
                });
            });
        </script>
        <script>
            // Improved Tab Switching
            const tabs = document.querySelectorAll('button[onclick^="document.getElementById"]');
            tabs.forEach(btn => {
                btn.addEventListener('click', function() {
                    tabs.forEach(b => {
                        b.style.color = 'var(--text-secondary)';
                        b.style.borderBottom = 'none';
                    });
                    this.style.color = 'var(--accent-500)';
                    this.style.borderBottom = '2px solid var(--accent-500)';
                });
            });
        </script>

        <!-- MY INVENTORY SECTION -->
        <div id="my-inventory">
            <div class="dashboard-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 24px;">
                <div class="card-erp" style="min-height: 120px; padding: 24px;">
                    <div>
                        <h4 style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Shop Identity</h4>
                        <div style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin-top: 8px;"><%= shop.shop_name %></div>
                        <div style="color: var(--text-secondary); margin-top: 4px;"><%= shop.shop_description || 'No description provided' %></div>
                    </div>
                </div>
                <div class="card-erp" style="min-height: 120px; padding: 24px;">
                    <div>
                        <h4 style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Asset SKUs Listed</h4>
                        <div style="font-size: 2rem; font-weight: 700; color: var(--accent-500); margin-top: 8px;"><%= products ? products.length : 0 %> Items</div>
                    </div>
                </div>
            </div>

            <div class="dashboard-grid" style="grid-template-columns: 2fr 1fr; gap: 24px;">
                <!-- Product List -->
                <div class="card-erp">
                    <h3 class="card-title" style="margin-bottom: 16px;">Current Inventory</h3>
                    <% if (products && products.length > 0) { %>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <% products.forEach(product => { %>
                                <% 
                                    let imgUrl = '/assets/images/placeholder.png';
                                    if (product.images) {
                                        try {
                                            let imgs = typeof product.images === 'string' ? JSON.parse(product.images) : product.images;
                                            if (imgs && imgs.length > 0) imgUrl = imgs[0];
                                        } catch(e){}
                                    }
                                %>
                                <div style="padding: 16px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; display: flex; flex-direction: column; gap: 16px;">
                                    
                                    <div style="display: flex; gap: 16px; align-items: center; justify-content: space-between;">
                                        <div style="display: flex; gap: 16px; align-items: center;">
                                            <img src="<%= imgUrl %>" alt="<%= product.name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
                                            <div>
                                                <div style="font-weight: 600; font-size: 1.1rem; color: var(--text-primary);"><%= product.name %></div>
                                                <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 4px;"><%= product.category %> | $<%= product.price %> | Stock: <%= product.stock_level %></div>
                                            </div>
                                        </div>
                                        <div style="display: flex; gap: 8px;">
                                            <button onclick="document.getElementById('edit-form-<%= product.id %>').style.display = document.getElementById('edit-form-<%= product.id %>').style.display === 'none' ? 'block' : 'none'" style="padding: 8px 12px; background: rgba(255,255,255,0.1); color: white; border: none; border-radius: 4px; cursor: pointer;">Edit</button>
                                            <form action="/inventory/product/<%= product.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');" style="margin: 0;">
                                                <button type="submit" style="padding: 8px 12px; background: rgba(255,50,50,0.1); color: #ff5555; border: 1px solid rgba(255,50,50,0.2); border-radius: 4px; cursor: pointer;">Delete</button>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- INLINE EDIT FORM -->
                                    <div id="edit-form-<%= product.id %>" style="display: none; padding: 16px; background: rgba(0,0,0,0.2); border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                                        <h4 style="margin-bottom: 12px; color: var(--text-primary);">Edit Product</h4>
                                        <form action="/inventory/product/<%= product.id %>/update" method="POST" style="display: flex; flex-direction: column; gap: 12px;">
                                            <div style="display: flex; gap: 12px;">
                                                <div style="flex: 1;">
                                                    <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Product Name</label>
                                                    <input type="text" name="name" value="<%= product.name %>" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                                </div>
                                                <div style="flex: 1;">
                                                    <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Category</label>
                                                    <input type="text" name="category" value="<%= product.category %>" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                                </div>
                                            </div>
                                            <div>
                                                <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Image URL</label>
                                                <input type="url" name="image_url" value="<%= imgUrl !== '/assets/images/placeholder.png' ? imgUrl : '' %>" style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                            </div>
                                            <div style="display: flex; gap: 12px;">
                                                <div style="flex: 1;">
                                                    <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Price ($)</label>
                                                    <input type="number" step="0.01" name="price" value="<%= product.price %>" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                                </div>
                                                <div style="flex: 1;">
                                                    <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Stock Level</label>
                                                    <input type="number" name="stock_level" value="<%= product.stock_level %>" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                                </div>
                                            </div>
                                            <div>
                                                <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Description</label>
                                                <textarea name="description" rows="2" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;"><%= product.description %></textarea>
                                            </div>
                                            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                                                <button type="button" onclick="document.getElementById('edit-form-<%= product.id %>').style.display='none'" style="padding: 8px 16px; background: none; color: var(--text-muted); border: none; cursor: pointer;">Cancel</button>
                                                <button type="submit" style="padding: 8px 16px; background: var(--accent-500); color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                    <!-- END INLINE EDIT FORM -->

                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p style="color: var(--text-muted);">No products found in your inventory.</p>
                    <% } %>
                </div>

                <!-- Add Product Form -->
                <div class="card-erp">
                    <h3 class="card-title" style="margin-bottom: 16px;">Log New Asset</h3>
                    <form action="/inventory/product/create" method="POST" style="display: flex; flex-direction: column; gap: 12px;">
                        <div>
                            <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Product Name</label>
                            <input type="text" name="name" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Image URL (Required)</label>
                            <input type="url" name="image_url" placeholder="https://example.com/image.jpg" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Category</label>
                            <input type="text" name="category" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                        </div>
                        <div style="display: flex; gap: 12px;">
                            <div style="flex: 1;">
                                <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Price ($)</label>
                                <input type="number" step="0.01" name="price" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                            </div>
                            <div style="flex: 1;">
                                <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Stock Level</label>
                                <input type="number" name="stock_level" value="0" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                            </div>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Description</label>
                            <textarea name="description" rows="3" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;"></textarea>
                        </div>
                        <button type="submit" style="padding: 12px; background: var(--accent-500); color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; margin-top: 8px;">Add to Catalog</button>
                    </form>
                </div>
            </div>
        </div>
    <% } %>


    <!-- MARKETPLACE LAYOUT (2-COLUMN) -->
    <!-- Display block if no shop, otherwise handled by tabs -->
    <div id="marketplace" style="<%= shop ? 'display: none;' : 'display: grid;' %> grid-template-columns: 240px 1fr; gap: 32px; align-items: start;">
        
        <!-- LEFT COLUMN: Categories & Toggles -->
        <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 24px; position: sticky; top: 24px;">
            <h3 style="margin-bottom: 16px; color: var(--text-primary); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px;">Discover</h3>
            
            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 32px;">
                <button onclick="document.getElementById('grid-products').style.display='block'; document.getElementById('grid-shops').style.display='none'; this.style.color='var(--accent-500)'; document.getElementById('btn-shops').style.color='var(--text-secondary)';" id="btn-products" style="text-align: left; background: none; border: none; color: var(--accent-500); cursor: pointer; padding: 8px 0; font-weight: 600; font-size: 1.05rem; display: flex; align-items: center; gap: 8px;"><span>📦</span> Products</button>
                <button onclick="document.getElementById('grid-products').style.display='none'; document.getElementById('grid-shops').style.display='block'; this.style.color='var(--accent-500)'; document.getElementById('btn-products').style.color='var(--text-secondary)';" id="btn-shops" style="text-align: left; background: none; border: none; color: var(--text-secondary); cursor: pointer; padding: 8px 0; font-weight: 600; font-size: 1.05rem; display: flex; align-items: center; gap: 8px;"><span>🏬</span> Businesses</button>
            </div>

            <h3 style="margin-bottom: 12px; color: var(--text-primary); font-size: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 8px;">Categories</h3>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px;">
                <li><a href="#" style="display: block; padding: 8px; color: var(--text-secondary); text-decoration: none; border-radius: 4px; transition: background 0.2s;">Raw Materials</a></li>
                <li><a href="#" style="display: block; padding: 8px; color: var(--text-secondary); text-decoration: none; border-radius: 4px; transition: background 0.2s;">Finished Goods</a></li>
                <li><a href="#" style="display: block; padding: 8px; color: var(--text-secondary); text-decoration: none; border-radius: 4px; transition: background 0.2s;">Machinery</a></li>
                <li><a href="#" style="display: block; padding: 8px; color: var(--text-secondary); text-decoration: none; border-radius: 4px; transition: background 0.2s;">Services</a></li>
                <li><a href="#" style="display: block; padding: 8px; color: var(--text-secondary); text-decoration: none; border-radius: 4px; transition: background 0.2s;">Consumables</a></li>
            </ul>

            <% if (!shop) { %>
                <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.1);">
                    <h4 style="color: var(--text-primary); margin-bottom: 8px;">Sell on Nautware</h4>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 16px;">Create a shop to start listing your own products.</p>
                    <button onclick="document.getElementById('shop-creation-modal').style.display='flex';" style="width: 100%; padding: 10px; background: var(--accent-500); color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">Create Shop</button>
                </div>
            <% } %>
        </div>

        <!-- RIGHT COLUMN: Grids -->
        <div>
            <!-- PRODUCTS GRID -->
            <div id="grid-products">
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px;">
                    <h2 style="margin: 0; color: var(--text-primary);">Products Directory</h2>
                    <span style="color: var(--text-muted); font-size: 0.9rem;"><%= marketplaceProducts ? marketplaceProducts.length : 0 %> items</span>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px;">
                    <% if (marketplaceProducts && marketplaceProducts.length > 0) { %>
                        <% marketplaceProducts.forEach(product => { %>
                            <% 
                                let imgUrl = '/assets/images/placeholder.png';
                                if (product.images) {
                                    try {
                                        let imgs = typeof product.images === 'string' ? JSON.parse(product.images) : product.images;
                                        if (imgs && imgs.length > 0) imgUrl = imgs[0];
                                    } catch(e){}
                                }
                            %>
                            <!-- FIXED DIMENSION CARD -->
                            <div class="card-erp" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; width: 100%; height: 340px; background: rgba(30,30,45,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px;">
                                <div style="height: 160px; width: 100%; background: #1a1a24; overflow: hidden;">
                                    <img src="<%= imgUrl %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                                </div>
                                <div style="padding: 16px; flex: 1; display: flex; flex-direction: column;">
                                    <div style="font-weight: 600; font-size: 1.05rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= product.name %>"><%= product.name %></div>
                                    <div style="color: var(--accent-500); font-weight: 700; margin-top: 4px; font-size: 1.1rem;">$<%= product.price %></div>
                                    
                                    <!-- Description with text clamping -->
                                    <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 8px; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        <%= product.description %>
                                    </div>
                                    
                                    <div style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.05); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        🏬 <%= product.shop_name %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: var(--text-muted); grid-column: 1 / -1;">No products found in the marketplace.</p>
                    <% } %>
                </div>
            </div>

            <!-- BUSINESSES GRID -->
            <div id="grid-shops" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px;">
                    <h2 style="margin: 0; color: var(--text-primary);">Businesses Directory</h2>
                    <span style="color: var(--text-muted); font-size: 0.9rem;"><%= marketplaceShops ? marketplaceShops.length : 0 %> shops</span>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
                    <% if (marketplaceShops && marketplaceShops.length > 0) { %>
                        <% marketplaceShops.forEach(mShop => { %>
                            <div class="card-erp" style="padding: 24px; display: flex; flex-direction: column; height: 200px; background: rgba(30,30,45,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; align-items: center; text-align: center;">
                                <div style="width: 64px; height: 64px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 12px;">
                                    🏬
                                </div>
                                <div style="font-weight: 700; font-size: 1.1rem; color: var(--text-primary); margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;"><%= mShop.shop_name %></div>
                                <div style="color: var(--text-muted); font-size: 0.85rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    <%= mShop.shop_description || 'No description provided.' %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: var(--text-muted); grid-column: 1 / -1;">No businesses found.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- SHOP CREATION MODAL (For users without a shop) -->
<% if (!shop) { %>
    <div id="shop-creation-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
        <div class="card-erp" style="width: 100%; max-width: 500px; position: relative;">
            <button onclick="document.getElementById('shop-creation-modal').style.display='none';" style="position: absolute; right: 16px; top: 16px; background: none; border: none; color: white; font-size: 1.2rem; cursor: pointer;">&times;</button>
            <h2 style="margin-bottom: 8px;">Create Your Shop</h2>
            <p style="color: var(--text-muted); margin-bottom: 24px;">Join the B2B network and start listing your assets.</p>
            
            <form action="/inventory/shop/create" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
                <div>
                    <label style="display: block; margin-bottom: 8px; color: var(--text-secondary);">Shop Name</label>
                    <input type="text" name="shopName" required style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                </div>
                <div>
                    <label style="display: block; margin-bottom: 8px; color: var(--text-secondary);">Shop Description</label>
                    <textarea name="shopDescription" rows="3" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;"></textarea>
                </div>
                <button type="submit" style="padding: 12px; background: var(--accent-500); color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; text-transform: uppercase; letter-spacing: 1px;">Initialize Shop</button>
            </form>
        </div>
    </div>
<% } %>

