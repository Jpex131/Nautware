<%- include('partials/header') %>

<!-- NEW NAVBAR BASED ON SKETCH & POLISHED -->
<nav class="erp-nav" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 24px; background: rgba(20,20,30,0.95); border-bottom: 1px solid rgba(255,255,255,0.1);">
    <div style="display: flex; gap: 32px; align-items: center;">
        <a href="/dashboard" title="Home" style="color: var(--text-secondary); text-decoration: none; display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </a>
        <a href="/inventory" title="Market" style="color: var(--accent-500); text-decoration: none; display: flex; align-items: center; justify-content: center; padding-bottom: 4px; border-bottom: 2px solid var(--accent-500);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </a>
        <button type="button" title="Shopping cart" aria-label="Open shopping cart" onclick="openCart()" style="position: relative; width: 36px; height: 36px; color: var(--text-secondary); background: transparent; border: 0; cursor: pointer; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <span id="cart-count" style="display: none; position: absolute; top: 0; right: 0; min-width: 17px; height: 17px; padding: 0 4px; border-radius: 9px; background: var(--accent-500); color: white; font-size: 0.7rem; line-height: 17px; text-align: center;"></span>
        </button>
        <a href="/services" title="Services" style="color: var(--text-secondary); text-decoration: none; display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </a>
        <a href="/finance" title="Finance" style="color: var(--text-secondary); text-decoration: none; display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </a>
    </div>
    
    <div style="flex: 1; max-width: 500px; margin: 0 24px;">
        <div style="position: relative;">
            <input type="text" id="global-search" placeholder="Search products..." style="width: 100%; padding: 10px 16px 10px 40px; border-radius: 20px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: white; outline: none; font-size: 0.95rem;">
            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-secondary); display: flex;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </span>
        </div>
    </div>
    
    <div style="display: flex; align-items: center; gap: 16px;">
        <div style="text-align: right;">
            <div style="color: var(--text-primary); font-size: 0.9rem; font-weight: 600;"><%= username %></div>
            <a href="/auth/logout" style="color: #ff5555; text-decoration: none; font-size: 0.75rem; text-transform: uppercase;">Disconnect</a>
        </div>
        <a href="/profile" title="Profile" style="width: 36px; height: 36px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-secondary); text-decoration: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
    </div>
</nav>

<div class="dashboard-container" style="padding-top: 24px; max-width: 1400px;">

    <% if (shop) { %>
        <!-- SELLER CONTROLS: Switch between My Inventory and Marketplace -->
        <div style="display: flex; gap: 16px; margin-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
            <button onclick="document.getElementById('my-inventory').style.display='block'; document.getElementById('marketplace').style.display='none';" style="background: none; border: none; color: var(--text-secondary); font-size: 1.1rem; font-weight: 600; cursor: pointer;">My Inventory (Seller)</button>
            <button onclick="document.getElementById('my-inventory').style.display='none'; document.getElementById('marketplace').style.display='grid';" style="background: none; border: none; color: var(--accent-500); font-size: 1.1rem; font-weight: 600; cursor: pointer; border-bottom: 2px solid var(--accent-500);">Marketplace (Buyer)</button>
        </div>
        
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                document.getElementById('my-inventory').style.display = 'block';
                document.getElementById('marketplace').style.display = 'none';
                document.querySelectorAll('button[onclick^="document.getElementById"]').forEach((btn, idx) => {
                    if(idx === 0) { btn.style.color = 'var(--accent-500)'; btn.style.borderBottom = '2px solid var(--accent-500)'; }
                    else { btn.style.color = 'var(--text-secondary)'; btn.style.borderBottom = 'none'; }
                });
            });
            const tabs = document.querySelectorAll('button[onclick^="document.getElementById"]');
            tabs.forEach(btn => {
                btn.addEventListener('click', function() {
                    tabs.forEach(b => { b.style.color = 'var(--text-secondary)'; b.style.borderBottom = 'none'; });
                    this.style.color = 'var(--accent-500)';
                    this.style.borderBottom = '2px solid var(--accent-500)';
                });
            });
        </script>

        <!-- MY INVENTORY SECTION -->
        <div id="my-inventory">
            <div class="dashboard-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 24px;">
                <div class="card-erp" style="min-height: 120px; padding: 24px;">
                    <div>
                        <h4 style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Shop Identity</h4>
                        <div style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin-top: 8px;"><%= shop.shop_name %></div>
                        <div style="color: var(--text-secondary); margin-top: 4px;"><%= shop.shop_description || 'No description provided' %></div>
                    </div>
                </div>
                <div class="card-erp" style="min-height: 120px; padding: 24px;">
                    <div>
                        <h4 style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Asset SKUs Listed</h4>
                        <div style="font-size: 2rem; font-weight: 700; color: var(--accent-500); margin-top: 8px;"><%= products ? products.length : 0 %> Items</div>
                    </div>
                </div>
            </div>

            <div class="dashboard-grid" style="grid-template-columns: 2fr 1fr; gap: 24px;">
                <!-- Product List -->
                <div class="card-erp">
                    <h3 class="card-title" style="margin-bottom: 16px;">Current Inventory</h3>
                    <% if (products && products.length > 0) { %>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <% products.forEach(product => { %>
                                <% 
                                    let imgUrl = '/assets/images/placeholder.png';
                                    if (product.images) {
                                        try {
                                            let imgs = typeof product.images === 'string' ? JSON.parse(product.images) : product.images;
                                            if (imgs && imgs.length > 0) imgUrl = imgs[0];
                                        } catch(e){}
                                    }
                                %>
                                <div style="padding: 16px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; display: flex; flex-direction: column; gap: 16px;">
                                    
                                    <div style="display: flex; gap: 16px; align-items: center; justify-content: space-between;">
                                        <div style="display: flex; gap: 16px; align-items: center;">
                                            <img src="<%= imgUrl %>" alt="<%= product.name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
                                            <div>
                                                <div style="font-weight: 600; font-size: 1.1rem; color: var(--text-primary);"><%= product.name %></div>
                                                <div style="color: var(--text-muted); font-size: 0.9rem; margin-top: 4px;"><%= product.category %> | $<%= product.price %> | Stock: <%= product.stock_level %></div>
                                            </div>
                                        </div>
                                        <div style="display: flex; gap: 8px;">
                                            <button onclick="document.getElementById('edit-form-<%= product.id %>').style.display = document.getElementById('edit-form-<%= product.id %>').style.display === 'none' ? 'block' : 'none'" style="padding: 8px 12px; background: rgba(255,255,255,0.1); color: white; border: none; border-radius: 4px; cursor: pointer;">Edit</button>
                                            <form action="/inventory/product/<%= product.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');" style="margin: 0;">
                                                <button type="submit" style="padding: 8px 12px; background: rgba(255,50,50,0.1); color: #ff5555; border: 1px solid rgba(255,50,50,0.2); border-radius: 4px; cursor: pointer;">Delete</button>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- INLINE EDIT FORM -->
                                    <div id="edit-form-<%= product.id %>" style="display: none; padding: 16px; background: rgba(0,0,0,0.2); border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                                        <h4 style="margin-bottom: 12px; color: var(--text-primary);">Edit Product</h4>
                                        <form action="/inventory/product/<%= product.id %>/update" method="POST" style="display: flex; flex-direction: column; gap: 12px;">
                                            <div style="display: flex; gap: 12px;">
                                                <div style="flex: 1;">
                                                    <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Product Name</label>
                                                    <input type="text" name="name" value="<%= product.name %>" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                                </div>
                                                <div style="flex: 1;">
                                                    <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Category</label>
                                                    <input type="text" name="category" value="<%= product.category %>" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                                </div>
                                            </div>
                                            <div>
                                                <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Image URL</label>
                                                <input type="url" name="image_url" value="<%= imgUrl !== '/assets/images/placeholder.png' ? imgUrl : '' %>" style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                            </div>
                                            <div style="display: flex; gap: 12px;">
                                                <div style="flex: 1;">
                                                    <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Price ($)</label>
                                                    <input type="number" step="0.01" name="price" value="<%= product.price %>" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                                </div>
                                                <div style="flex: 1;">
                                                    <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Stock Level</label>
                                                    <input type="number" name="stock_level" value="<%= product.stock_level %>" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                                </div>
                                            </div>
                                            <div>
                                                <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.85rem;">Description</label>
                                                <textarea name="description" rows="2" required style="width: 100%; padding: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;"><%= product.description %></textarea>
                                            </div>
                                            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                                                <button type="button" onclick="document.getElementById('edit-form-<%= product.id %>').style.display='none'" style="padding: 8px 16px; background: none; color: var(--text-muted); border: none; cursor: pointer;">Cancel</button>
                                                <button type="submit" style="padding: 8px 16px; background: var(--accent-500); color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p style="color: var(--text-muted);">No products found in your inventory.</p>
                    <% } %>
                </div>

                <!-- Add Product Form -->
                <div class="card-erp">
                    <h3 class="card-title" style="margin-bottom: 16px;">Log New Asset</h3>
                    <form action="/inventory/product/create" method="POST" style="display: flex; flex-direction: column; gap: 12px;">
                        <div>
                            <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Product Name</label>
                            <input type="text" name="name" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Image URL (Required)</label>
                            <input type="url" name="image_url" placeholder="https://example.com/image.jpg" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Category</label>
                            <!-- Updated categories to generic base -->
                            <select name="category" required style="width: 100%; padding: 10px; background: rgba(30,30,45,0.9); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                                <option value="Electronics">Electronics</option>
                                <option value="Raw Materials">Raw Materials</option>
                                <option value="Technology">Technology</option>
                                <option value="Machinery">Machinery</option>
                                <option value="Services">Services</option>
                                <option value="Consumables">Consumables</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div style="display: flex; gap: 12px;">
                            <div style="flex: 1;">
                                <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Price ($)</label>
                                <input type="number" step="0.01" name="price" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                            </div>
                            <div style="flex: 1;">
                                <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Stock Level</label>
                                <input type="number" name="stock_level" value="0" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                            </div>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 4px; color: var(--text-secondary); font-size: 0.9rem;">Description</label>
                            <textarea name="description" rows="3" required style="width: 100%; padding: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;"></textarea>
                        </div>
                        <button type="submit" style="padding: 12px; background: var(--accent-500); color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; margin-top: 8px;">Add to Catalog</button>
                    </form>
                </div>
            </div>
        </div>
    <% } %>

    <!-- MARKETPLACE LAYOUT -->
    <% if (shop) { %>
    <div id="marketplace" style="display: none; grid-template-columns: 240px 1fr; gap: 32px; align-items: start;">
    <% } else { %>
    <div id="marketplace" style="display: grid; grid-template-columns: 240px 1fr; gap: 32px; align-items: start;">
    <% } %>
        
        <!-- LEFT COLUMN: Categories & Toggles -->
        <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 24px; position: sticky; top: 100px;">
            <h3 style="margin-bottom: 16px; color: var(--text-primary); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px;">Discover</h3>
            
            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 32px;">
                <button onclick="document.getElementById('grid-products').style.display='block'; document.getElementById('grid-shops').style.display='none'; this.style.color='var(--accent-500)'; document.getElementById('btn-shops').style.color='var(--text-secondary)';" id="btn-products" style="text-align: left; background: none; border: none; color: var(--accent-500); cursor: pointer; padding: 8px 0; font-weight: 600; font-size: 1.05rem; display: flex; align-items: center; gap: 8px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    Products
                </button>
                <button onclick="document.getElementById('grid-products').style.display='none'; document.getElementById('grid-shops').style.display='block'; this.style.color='var(--accent-500)'; document.getElementById('btn-products').style.color='var(--text-secondary)';" id="btn-shops" style="text-align: left; background: none; border: none; color: var(--text-secondary); cursor: pointer; padding: 8px 0; font-weight: 600; font-size: 1.05rem; display: flex; align-items: center; gap: 8px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                    Businesses
                </button>
            </div>

            <h3 style="margin-bottom: 12px; color: var(--text-primary); font-size: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 8px;">Categories</h3>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px;">
                <li><button class="cat-filter" data-cat="All" onclick="filterCategory('All')" style="width: 100%; text-align: left; background: none; border: none; padding: 8px; color: var(--accent-500); font-weight: 600; cursor: pointer; border-radius: 4px; transition: background 0.2s;">All Categories</button></li>
                <li><button class="cat-filter" data-cat="Electronics" onclick="filterCategory('Electronics')" style="width: 100%; text-align: left; background: none; border: none; padding: 8px; color: var(--text-secondary); cursor: pointer; border-radius: 4px; transition: background 0.2s;">Electronics</button></li>
                <li><button class="cat-filter" data-cat="Raw Materials" onclick="filterCategory('Raw Materials')" style="width: 100%; text-align: left; background: none; border: none; padding: 8px; color: var(--text-secondary); cursor: pointer; border-radius: 4px; transition: background 0.2s;">Raw Materials</button></li>
                <li><button class="cat-filter" data-cat="Technology" onclick="filterCategory('Technology')" style="width: 100%; text-align: left; background: none; border: none; padding: 8px; color: var(--text-secondary); cursor: pointer; border-radius: 4px; transition: background 0.2s;">Technology</button></li>
                <li><button class="cat-filter" data-cat="Machinery" onclick="filterCategory('Machinery')" style="width: 100%; text-align: left; background: none; border: none; padding: 8px; color: var(--text-secondary); cursor: pointer; border-radius: 4px; transition: background 0.2s;">Machinery</button></li>
                <li><button class="cat-filter" data-cat="Services" onclick="filterCategory('Services')" style="width: 100%; text-align: left; background: none; border: none; padding: 8px; color: var(--text-secondary); cursor: pointer; border-radius: 4px; transition: background 0.2s;">Services</button></li>
                <li><button class="cat-filter" data-cat="Consumables" onclick="filterCategory('Consumables')" style="width: 100%; text-align: left; background: none; border: none; padding: 8px; color: var(--text-secondary); cursor: pointer; border-radius: 4px; transition: background 0.2s;">Consumables</button></li>
            </ul>

            <script>
                function filterCategory(cat) {
                    // Update active state
                    document.querySelectorAll('.cat-filter').forEach(btn => {
                        if (btn.dataset.cat === cat) {
                            btn.style.color = 'var(--accent-500)';
                            btn.style.fontWeight = '600';
                        } else {
                            btn.style.color = 'var(--text-secondary)';
                            btn.style.fontWeight = 'normal';
                        }
                    });
                    
                    // Filter products
                    const cards = document.querySelectorAll('.mkt-product-card');
                    let count = 0;
                    cards.forEach(card => {
                        if (cat === 'All' || card.dataset.category === cat) {
                            card.style.display = 'flex';
                            count++;
                        } else {
                            card.style.display = 'none';
                        }
                    });
                    document.getElementById('mkt-product-count').innerText = `${count} items`;
                }

                // Simple search implementation
                document.getElementById('global-search').addEventListener('input', function(e) {
                    const term = e.target.value.toLowerCase();
                    const cards = document.querySelectorAll('.mkt-product-card');
                    cards.forEach(card => {
                        const name = card.dataset.name.toLowerCase();
                        if (name.includes(term)) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            </script>

            <% if (!shop) { %>
                <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.1);">
                    <h4 style="color: var(--text-primary); margin-bottom: 8px;">Sell on Nautware</h4>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 16px;">Create a shop to start listing your own products.</p>
                    <button onclick="document.getElementById('shop-creation-modal').style.display='flex';" style="width: 100%; padding: 10px; background: var(--accent-500); color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer;">Create Shop</button>
                </div>
            <% } %>
        </div>

        <!-- RIGHT COLUMN: Grids -->
        <div>
            <!-- PRODUCTS GRID -->
            <div id="grid-products">
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px;">
                    <h2 style="margin: 0; color: var(--text-primary);">Products Directory</h2>
                    <span id="mkt-product-count" style="color: var(--text-muted); font-size: 0.9rem;"><%= marketplaceProducts ? marketplaceProducts.length : 0 %> items</span>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px;">
                    <% if (marketplaceProducts && marketplaceProducts.length > 0) { %>
                        <% marketplaceProducts.forEach(product => { %>
                            <% 
                                let imgUrl = '/assets/images/placeholder.png';
                                if (product.images) {
                                    try {
                                        let imgs = typeof product.images === 'string' ? JSON.parse(product.images) : product.images;
                                        if (imgs && imgs.length > 0) imgUrl = imgs[0];
                                    } catch(e){}
                                }
                            %>
                            <div class="card-erp mkt-product-card" 
                                   data-product-id="<%= product.id %>"
                                 data-category="<%= product.category %>" 
                                 data-name="<%= product.name %>"
                                 data-price="<%= product.price %>"
                                 data-desc="<%= product.description %>"
                                 data-img="<%= imgUrl %>"
                                 data-shop="<%= product.shop_name %>"
                                 onclick="openModalFromCard(this)"
                                 style="padding: 0; overflow: hidden; display: flex; flex-direction: column; width: 100%; height: 340px; background: rgba(30,30,45,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; cursor: pointer; transition: border-color 0.2s, transform 0.2s;">
                                
                                <div style="height: 160px; width: 100%; background: #1a1a24; overflow: hidden;">
                                    <img src="<%= imgUrl %>" alt="<%= product.name %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                                </div>
                                <div style="padding: 16px; flex: 1; display: flex; flex-direction: column;">
                                    <div style="font-weight: 600; font-size: 1.05rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= product.name %>"><%= product.name %></div>
                                    <div style="color: var(--accent-500); font-weight: 700; margin-top: 4px; font-size: 1.1rem;">$<%= product.price %></div>
                                    
                                    <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 8px; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        <%= product.description %>
                                    </div>
                                    
                                    <div style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.05); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; gap: 6px;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                                        <%= product.shop_name %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: var(--text-muted); grid-column: 1 / -1;">No products found in the marketplace.</p>
                    <% } %>
                </div>
            </div>

            <!-- BUSINESSES GRID -->
            <div id="grid-shops" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px;">
                    <h2 style="margin: 0; color: var(--text-primary);">Businesses Directory</h2>
                    <span style="color: var(--text-muted); font-size: 0.9rem;"><%= marketplaceShops ? marketplaceShops.length : 0 %> shops</span>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
                    <% if (marketplaceShops && marketplaceShops.length > 0) { %>
                        <% marketplaceShops.forEach(mShop => { %>
                            <div class="card-erp" onclick="window.location.href='/inventory/shop/<%= mShop.shop_slug %>'" style="cursor: pointer; padding: 24px; display: flex; flex-direction: column; height: 200px; background: rgba(30,30,45,0.6); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; align-items: center; text-align: center;">
                                <div style="width: 64px; height: 64px; background: rgba(255,255,255,0.05); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--accent-500); margin-bottom: 12px;">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                                </div>
                                <div style="font-weight: 700; font-size: 1.1rem; color: var(--text-primary); margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;"><%= mShop.shop_name %></div>
                                <div style="color: var(--text-muted); font-size: 0.85rem; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    <%= mShop.shop_description || 'No description provided.' %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: var(--text-muted); grid-column: 1 / -1;">No businesses found.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- PRODUCT DETAILS MODAL -->
<div id="product-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(10,10,15,0.85); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 24px;">
    <div style="background: var(--bg-surface); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; width: 100%; max-width: 900px; display: flex; overflow: hidden; position: relative; box-shadow: 0 24px 48px rgba(0,0,0,0.5); max-height: 90vh;">
        
        <button onclick="document.getElementById('product-modal-overlay').style.display='none';" style="position: absolute; right: 16px; top: 16px; background: rgba(0,0,0,0.5); border: none; color: white; width: 32px; height: 32px; border-radius: 50%; font-size: 1.2rem; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10;">&times;</button>
        
        <!-- Image Side -->
        <div style="flex: 1; background: #1a1a24; display: flex; align-items: center; justify-content: center; min-height: 400px; max-width: 450px;">
            <img id="modal-img" src="" alt="" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        
        <!-- Content Side -->
        <div style="flex: 1; padding: 40px 32px; display: flex; flex-direction: column; overflow-y: auto;">
            <div style="color: var(--text-secondary); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                <span id="modal-shop">Shop Name</span>
            </div>
            <h2 id="modal-name" style="color: var(--text-primary); font-size: 2rem; margin-bottom: 8px;">Product Name</h2>
            <div id="modal-price" style="color: var(--accent-500); font-weight: 700; font-size: 1.8rem; margin-bottom: 24px;">$0.00</div>
            
            <div style="flex: 1;">
                <h4 style="color: var(--text-primary); margin-bottom: 8px; font-size: 1rem;">Description</h4>
                <p id="modal-desc" style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;"></p>
            </div>

            <section style="margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.1);">
                <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px;">
                    <h3 style="margin: 0; color: var(--text-primary); font-size: 1.1rem;">Reviews</h3>
                    <span id="review-summary" style="color: var(--text-muted); font-size: 0.9rem;">Loading...</span>
                </div>
                <p id="review-status" role="status" style="color: var(--text-muted); font-size: 0.9rem; margin: 12px 0;"></p>
                <div id="review-list" style="display: flex; flex-direction: column; gap: 12px;"></div>
                <form id="review-form" style="display: none; margin-top: 16px; flex-direction: column; gap: 10px;">
                    <label for="review-rating" style="color: var(--text-secondary); font-size: 0.9rem;">Your rating</label>
                    <select id="review-rating" name="rating" required style="padding: 10px; background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255,255,255,0.15); border-radius: 4px;">
                        <option value="5">5 - Excellent</option>
                        <option value="4">4 - Good</option>
                        <option value="3">3 - Average</option>
                        <option value="2">2 - Poor</option>
                        <option value="1">1 - Very poor</option>
                    </select>
                    <label for="review-comment" style="color: var(--text-secondary); font-size: 0.9rem;">Comment</label>
                    <textarea id="review-comment" name="comment" rows="3" maxlength="5000" placeholder="Share your experience" style="padding: 10px; background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255,255,255,0.15); border-radius: 4px; resize: vertical;"></textarea>
                    <button type="submit" style="padding: 10px 14px; align-self: flex-start; background: var(--accent-500); color: white; border: 0; border-radius: 4px; font-weight: 600; cursor: pointer;">Submit review</button>
                </form>
            </section>
            
            <div style="display: flex; gap: 16px; margin-top: 32px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.1);">
                <button type="button" onclick="addActiveProductToCart()" style="flex: 1; padding: 14px; background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255,255,255,0.2); border-radius: 6px; font-weight: 600; font-size: 1rem; cursor: pointer;">Add to Cart</button>
                <button type="button" onclick="buyActiveProductNow()" style="flex: 1; padding: 14px; background: var(--accent-500); color: white; border: none; border-radius: 6px; font-weight: 600; font-size: 1rem; cursor: pointer;">Buy Now</button>
            </div>
            <p id="cart-action-status" role="status" style="color: var(--text-muted); font-size: 0.9rem; min-height: 1.2em;"></p>
        </div>
    </div>
</div>

<div id="cart-overlay" style="display: none; position: fixed; inset: 0; z-index: 1100; background: rgba(10,10,15,0.85); align-items: center; justify-content: center; padding: 20px;">
    <section role="dialog" aria-modal="true" aria-labelledby="cart-title" style="width: 100%; max-width: 620px; max-height: 85vh; overflow-y: auto; padding: 24px; background: var(--bg-surface); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 16px;">
            <h2 id="cart-title" style="margin: 0; color: var(--text-primary);">Your Cart</h2>
            <button type="button" title="Close cart" aria-label="Close cart" onclick="closeCart()" style="width: 36px; height: 36px; color: var(--text-primary); background: rgba(255,255,255,0.06); border: 0; border-radius: 4px; cursor: pointer; font-size: 1.2rem;">&times;</button>
        </div>
        <p id="cart-status" role="status" style="color: var(--text-muted);"></p>
        <div id="cart-items" style="display: flex; flex-direction: column; gap: 12px;"></div>
        <div style="display: flex; justify-content: space-between; gap: 16px; padding-top: 16px; margin-top: 16px; border-top: 1px solid rgba(255,255,255,0.1); color: var(--text-primary); font-weight: 700;">
            <span>Total</span>
            <span id="cart-total">$0.00</span>
        </div>
        <button id="checkout-button" type="button" onclick="startCheckout()" style="width: 100%; margin-top: 18px; padding: 13px; background: var(--accent-500); color: white; border: 0; border-radius: 4px; font-weight: 700; cursor: pointer;">Continue to Lightning checkout</button>
    </section>
</div>

<script>
    let activeReviewProductId = null;

    function formatCartMoney(cents) {
        return `$${(Number(cents) / 100).toFixed(2)}`;
    }

    async function orderRequest(url, options = {}) {
        const response = await fetch(url, {
            ...options,
            headers: { 'Content-Type': 'application/json', ...options.headers }
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Request failed');
        return data;
    }

    async function loadCart() {
        const data = await orderRequest('/orders/cart');
        const items = data.items || [];
        const count = items.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
        const badge = document.getElementById('cart-count');
        badge.textContent = count > 99 ? '99+' : String(count);
        badge.style.display = count ? 'block' : 'none';

        const list = document.getElementById('cart-items');
        const status = document.getElementById('cart-status');
        const checkoutButton = document.getElementById('checkout-button');
        list.replaceChildren();
        status.textContent = items.length ? '' : 'Your cart is empty.';

        let hasUnavailableItem = false;
        items.forEach(item => {
            const row = document.createElement('article');
            row.style.cssText = 'display: grid; grid-template-columns: minmax(0, 1fr) 84px auto; align-items: center; gap: 12px; padding: 12px; background: rgba(255,255,255,0.04); border-radius: 4px;';
            const details = document.createElement('div');
            const name = document.createElement('strong');
            name.textContent = item.name || 'Unavailable product';
            const shop = document.createElement('div');
            shop.textContent = item.shopName || 'Product no longer available';
            shop.style.cssText = 'margin-top: 4px; color: var(--text-muted); font-size: 0.82rem;';
            const price = document.createElement('div');
            price.textContent = item.unitPriceCents == null ? 'Unavailable' : `${formatCartMoney(item.unitPriceCents)} each`;
            price.style.cssText = 'margin-top: 4px; color: var(--text-secondary); font-size: 0.88rem;';
            details.append(name, shop, price);

            const quantity = document.createElement('input');
            quantity.type = 'number';
            quantity.min = '1';
            quantity.max = String(item.stockLevel || item.quantity);
            quantity.value = String(item.quantity);
            quantity.setAttribute('aria-label', `Quantity for ${item.name || 'unavailable product'}`);
            quantity.disabled = item.unavailable;
            quantity.style.cssText = 'width: 72px; min-height: 38px; padding: 6px; color: white; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 4px;';
            quantity.addEventListener('change', async () => {
                try {
                    await orderRequest(`/orders/cart/items/${item.productId}`, {
                        method: 'PATCH',
                        body: JSON.stringify({ quantity: Number(quantity.value) })
                    });
                    await loadCart();
                } catch (error) {
                    document.getElementById('cart-status').textContent = error.message;
                    await loadCart();
                    document.getElementById('cart-status').textContent = error.message;
                }
            });

            const actions = document.createElement('div');
            actions.style.cssText = 'display: flex; align-items: center; gap: 10px;';
            const subtotal = document.createElement('strong');
            subtotal.textContent = item.lineTotalCents == null ? '' : formatCartMoney(item.lineTotalCents);
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.textContent = 'Remove';
            remove.style.cssText = 'padding: 6px 8px; color: var(--text-secondary); background: transparent; border: 1px solid rgba(255,255,255,0.15); border-radius: 4px; cursor: pointer;';
            remove.addEventListener('click', async () => {
                try {
                    await orderRequest(`/orders/cart/items/${item.productId}`, { method: 'DELETE' });
                    await loadCart();
                } catch (error) {
                    document.getElementById('cart-status').textContent = error.message;
                }
            });
            actions.append(subtotal, remove);
            row.append(details, quantity, actions);
            list.append(row);
            hasUnavailableItem ||= Boolean(item.unavailable);
        });

        document.getElementById('cart-total').textContent = formatCartMoney(data.totalCents || 0);
        checkoutButton.disabled = items.length === 0 || hasUnavailableItem;
        checkoutButton.style.opacity = checkoutButton.disabled ? '0.5' : '1';
    }

    async function openCart() {
        document.getElementById('cart-overlay').style.display = 'flex';
        try {
            await loadCart();
        } catch (error) {
            document.getElementById('cart-status').textContent = error.message;
        }
    }

    function closeCart() {
        document.getElementById('cart-overlay').style.display = 'none';
    }

    async function startCheckout() {
        const button = document.getElementById('checkout-button');
        const status = document.getElementById('cart-status');
        button.disabled = true;
        status.textContent = 'Preparing your Lightning invoice...';
        try {
            const data = await orderRequest('/orders/checkout', { method: 'POST', body: '{}' });
            window.location.href = data.checkoutUrl;
        } catch (error) {
            status.textContent = error.message;
            button.disabled = false;
        }
    }

    async function addActiveProductToCart() {
        const status = document.getElementById('cart-action-status');
        try {
            await orderRequest(`/orders/cart/items/${activeReviewProductId}`, {
                method: 'POST',
                body: JSON.stringify({ quantity: 1 })
            });
            status.textContent = 'Added to your cart.';
            await loadCart();
        } catch (error) {
            status.textContent = error.message;
        }
    }

    async function buyActiveProductNow() {
        const status = document.getElementById('cart-action-status');
        try {
            await orderRequest(`/orders/cart/items/${activeReviewProductId}`, {
                method: 'POST',
                body: JSON.stringify({ quantity: 1 })
            });
            const data = await orderRequest('/orders/checkout', { method: 'POST', body: '{}' });
            window.location.href = data.checkoutUrl;
        } catch (error) {
            status.textContent = error.message;
        }
    }

    async function loadProductReviews(productId) {
        const status = document.getElementById('review-status');
        const summary = document.getElementById('review-summary');
        const reviewList = document.getElementById('review-list');
        const reviewForm = document.getElementById('review-form');
        reviewForm.style.display = 'none';
        reviewList.replaceChildren();
        status.textContent = 'Loading reviews...';

        try {
            const response = await fetch(`/inventory/product/${productId}/reviews`);
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Could not load reviews');

            summary.textContent = `${Number(data.averageRating).toFixed(1)} / 5 (${data.reviewCount} reviews)`;
            if (data.reviews.length === 0) {
                const emptyState = document.createElement('p');
                emptyState.textContent = 'No reviews yet.';
                emptyState.style.color = 'var(--text-muted)';
                reviewList.append(emptyState);
            } else {
                data.reviews.forEach(review => {
                    const item = document.createElement('article');
                    item.style.cssText = 'padding: 12px; background: rgba(255,255,255,0.04); border-radius: 4px;';
                    const heading = document.createElement('strong');
                    heading.textContent = `${review.reviewer_name} - ${review.rating}/5`;
                    const date = document.createElement('small');
                    date.textContent = ` · ${new Date(review.created_at).toLocaleDateString()}`;
                    date.style.color = 'var(--text-muted)';
                    const comment = document.createElement('p');
                    comment.textContent = review.comment || 'No written comment.';
                    comment.style.cssText = 'margin: 8px 0 0; color: var(--text-secondary); white-space: pre-wrap;';
                    item.append(heading, date, comment);
                    reviewList.append(item);
                });
            }

            reviewForm.style.display = data.canReview ? 'flex' : 'none';
            if (data.canReview) {
                status.textContent = 'Your completed purchase makes you eligible to review this product.';
            } else if (data.isSeller) {
                status.textContent = 'You cannot review your own product.';
            } else if (data.hasReviewed) {
                status.textContent = 'You have already reviewed this product.';
            } else {
                status.textContent = 'A completed purchase is required to leave a review.';
            }
        } catch (error) {
            summary.textContent = '';
            status.textContent = error.message;
        }
    }

    document.getElementById('review-form').addEventListener('submit', async event => {
        event.preventDefault();
        if (!activeReviewProductId) return;

        const status = document.getElementById('review-status');
        const formData = new FormData(event.currentTarget);
        try {
            const response = await fetch(`/inventory/product/${activeReviewProductId}/reviews`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    rating: formData.get('rating'),
                    comment: formData.get('comment')
                })
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Could not submit review');

            event.currentTarget.reset();
            await loadProductReviews(activeReviewProductId);
            status.textContent = 'Your review was submitted.';
        } catch (error) {
            status.textContent = error.message;
        }
    });

    function openModalFromCard(el) {
        activeReviewProductId = el.dataset.productId;
        document.getElementById('cart-action-status').textContent = '';
        document.getElementById('modal-name').innerText = el.dataset.name;
        document.getElementById('modal-price').innerText = '$' + el.dataset.price;
        document.getElementById('modal-desc').innerText = el.dataset.desc;
        document.getElementById('modal-img').src = el.dataset.img;
        document.getElementById('modal-shop').innerText = el.dataset.shop;
        document.getElementById('product-modal-overlay').style.display = 'flex';
        loadProductReviews(activeReviewProductId);
    }

    loadCart().catch(() => {});
</script>

<!-- SHOP CREATION MODAL -->
<% if (!shop) { %>
    <div id="shop-creation-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
        <div class="card-erp" style="width: 100%; max-width: 500px; position: relative;">
            <button onclick="document.getElementById('shop-creation-modal').style.display='none';" style="position: absolute; right: 16px; top: 16px; background: none; border: none; color: white; font-size: 1.2rem; cursor: pointer;">&times;</button>
            <h2 style="margin-bottom: 8px;">Create Your Shop</h2>
            <p style="color: var(--text-muted); margin-bottom: 24px;">Join the B2B network and start listing your assets.</p>
            
            <form action="/inventory/shop/create" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
                <div>
                    <label style="display: block; margin-bottom: 8px; color: var(--text-secondary);">Shop Name</label>
                    <input type="text" name="shopName" required style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;">
                </div>
                <div>
                    <label style="display: block; margin-bottom: 8px; color: var(--text-secondary);">Shop Description</label>
                    <textarea name="shopDescription" rows="3" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 4px;"></textarea>
                </div>
                <button type="submit" style="padding: 12px; background: var(--accent-500); color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; text-transform: uppercase; letter-spacing: 1px;">Initialize Shop</button>
            </form>
        </div>
    </div>
<% } %>

<%- include('partials/footer') %>
