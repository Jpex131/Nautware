<%- include('partials/header') %>

<nav class="erp-nav">
    <div class="erp-nav-logo">
        <img src="/assets/images/naut_logo.png" alt="Naut Logo" style="height: 32px;">
        <span style="font-weight: 700; letter-spacing: 2px; font-size: 1.1rem; text-transform: uppercase;">Nautware</span>
    </div>
    <ul class="erp-nav-links">
        <li><a href="/dashboard" class="active">Dashboard</a></li>
        <li><a href="/finance">Finance</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/inventory">Inventory</a></li>
        <li><a href="/auth/logout" class="btn-logout">Disconnect</a></li>
    </ul>
</nav>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h1>Command Dashboard</h1>
            <p style="color: var(--text-secondary); margin-top: 4px;">Welcome back, Operator. System status is nominal.</p>
        </div>
        <div class="user-badge">
            <span class="badge-avatar"></span>
            <span>Operator: <%= username %></span>
        </div>
    </div>

    <div class="dashboard-grid">
        <!-- Finance Card -->
        <div class="card-erp">
            <div>
                <div class="card-icon">💸</div>
                <h3 class="card-title">Finance Analitica</h3>
                <p class="card-desc">The financial heartbeat of the platform. Passive transaction ledger monitoring, cash flow analytics, and operational margins tracking.</p>
            </div>
            <a href="/finance" class="card-action">Access Ledger &rarr;</a>
        </div>

        <!-- Services Card -->
        <div class="card-erp">
            <div>
                <div class="card-icon">📅</div>
                <h3 class="card-title">Service Management</h3>
                <p class="card-desc">Operational scheduling engine and logistics calendar. Coordinate provider tasks, track property maintenance, and log completions.</p>
            </div>
            <a href="/services" class="card-action">Open Calendar &rarr;</a>
        </div>

        <!-- Inventory Card -->
        <div class="card-erp">
            <div>
                <div class="card-icon">📦</div>
                <h3 class="card-title">Product Manejo</h3>
                <p class="card-desc">Asset and stock level catalog management. Track physical resources, supplier configurations, and execute automated purchase orders.</p>
            </div>
            <a href="/inventory" class="card-action">Manage Inventory &rarr;</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
