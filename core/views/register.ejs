<%- include('partials/header') %>

<div class="auth-container">
    <div class="auth-bg-glow"></div>
    <div class="auth-card">
        <a href="/" class="back-link">&larr; Back to Main Site</a>
        
        <div class="auth-logo">
            <img src="/assets/images/naut_logo.png" alt="Naut Logo">
            <h2>Register Operator</h2>
        </div>

        <% if (error) { %>
            <div class="auth-error">
                <%= error %>
            </div>
        <% } %>

        <form class="auth-form" action="/auth/register" method="POST">
            <div class="form-group">
                <label for="name">Operator Full Name</label>
                <input type="text" id="name" name="name" placeholder="Jane Doe" required>
            </div>

            <div class="form-group">
                <label for="email">Work Email</label>
                <input type="email" id="email" name="email" placeholder="jane@naut.com" required>
            </div>
            
            <div class="form-group">
                <label for="password">Create Security Password</label>
                <input type="password" id="password" name="password" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-primary" style="margin-top: 12px; width: 100%;">Create Account</button>
        </form>

        <div class="auth-footer-links">
            Already registered? <a href="/login">Authenticate Here</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
